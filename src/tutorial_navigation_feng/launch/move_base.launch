<?xml version="1.0"?>
<launch>
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <rosparam file="$(find tutorial_navigation_feng)/param/costmap_common_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find tutorial_navigation_feng)/param/costmap_common_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find tutorial_navigation_feng)/param/global_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find tutorial_navigation_feng)/param/local_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find tutorial_navigation_feng)/param/global_planner_params.yaml" command="load" ns="GlobalPlanner"/>
        <rosparam file="$(find tutorial_navigation_feng)/param/dwa_local_planner_params.yaml" command="load" ns="DWAPlannerROS"/>
        <rosparam file="$(find tutorial_navigation_feng)/param/move_base_params.yaml" command="load"/>
    
        <remap from="odom" to="/Odometry"/>
    </node>
</launch>
