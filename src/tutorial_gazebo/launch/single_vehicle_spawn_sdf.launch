<?xml version="1.0"?>
<launch>
    <!-- Posix SITL environment launch script -->
    <!-- launchs PX4 SITL and spawns vehicle -->
    <!-- vehicle pose -->
    <arg name="x" default="0"/>
    <arg name="y" default="0"/>
    <arg name="z" default="0"/>
    <arg name="R" default="0"/>
    <arg name="P" default="0"/>
    <arg name="Y" default="0"/>
    <!-- vehcile model and config -->
    <arg name="est" default="ekf2"/>
    <arg name="vehicle" default="plane"/>
    <arg name="sdf"/>
    <arg name="ID" default="1"/>
    <env name="PX4_SIM_MODEL" value="$(arg vehicle)" />
    <env name="PX4_ESTIMATOR" value="$(arg est)" />
    <arg name="mavlink_udp_port" default="14560"/>
    <arg name="mavlink_tcp_port" default="4560"/>
    <arg name="robot_namespace" default=""/>
    <arg name="gazebo_namespace" default=""/>
    <arg name="reference_frame" default=""/>
    <!-- PX4 configs -->
    <arg name="interactive" default="true"/>
    <arg name="px4_startup_script" default="$(find tutorial_gazebo)/px4/init.d-posix/rcS"/>
    <!-- generate sdf vehicle model -->
    <arg name="cmd" default="xmlstarlet ed -d '//plugin[@name=&quot;mavlink_interface&quot;]/mavlink_tcp_port' -s '//plugin[@name=&quot;mavlink_interface&quot;]' -t elem -n mavlink_tcp_port -v $(arg mavlink_tcp_port) -d '//plugin[@name=&quot;mavlink_interface&quot;]/mavlink_udp_port' -s '//plugin[@name=&quot;mavlink_interface&quot;]' -t elem -n mavlink_udp_port -v $(arg mavlink_udp_port) $(arg sdf)"/>
    <param command="$(arg cmd)" name="model_description"/>
    <!-- PX4 SITL -->
    <arg unless="$(arg interactive)" name="px4_command_arg1" value=""/>
    <arg     if="$(arg interactive)" name="px4_command_arg1" value="-d"/>
    <node name="sitl_$(arg ID)" pkg="px4" type="px4" output="screen" args="$(find px4)/build/px4_sitl_default/etc -s $(arg px4_startup_script) -i $(arg ID) -w sitl_$(arg vehicle)_$(arg ID) $(arg px4_command_arg1)">
    </node>
    <!-- spawn vehicle -->
    <arg unless="$(eval len(arg('robot_namespace')) > 0)" name="robot_ns" value=""/>
    <arg     if="$(eval len(arg('robot_namespace')) > 0)" name="robot_ns" value="-robot_namespace $(arg robot_namespace)"/>
    <arg unless="$(eval len(arg('gazebo_namespace')) > 0)" name="gazebo_ns" value=""/>
    <arg     if="$(eval len(arg('gazebo_namespace')) > 0)" name="gazebo_ns" value="-gazebo_namespace $(arg gazebo_namespace)"/>
    <arg unless="$(eval len(arg('reference_frame')) > 0)" name="frame" value=""/>
    <arg     if="$(eval len(arg('reference_frame')) > 0)" name="frame" value="-reference_frame $(arg reference_frame)"/>
    <node name="$(arg vehicle)_$(arg ID)_spawn" output="screen" pkg="gazebo_ros" type="spawn_model" args="-sdf -param model_description -model $(arg vehicle)_$(arg ID) $(arg robot_ns) $(arg gazebo_ns) $(arg frame) -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg R) -P $(arg P) -Y $(arg Y)"/>
</launch>
