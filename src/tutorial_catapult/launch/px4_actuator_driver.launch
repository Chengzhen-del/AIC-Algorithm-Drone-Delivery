<?xml version="1.0"?>
<launch>
    <arg name="front_servo_1_pin" default="0"/>
    <arg name="front_servo_2_pin" default="3"/>
    <arg name="back_servo_1_pin" default="1"/>
    <arg name="back_servo_2_pin" default="2"/>
    <arg name="open_width" default="12.0"/>
    <arg name="close_width" default="3.0"/>

    <node pkg="tutorial_catapult" type="actuator_driver" name="actuator_driver"/>
</launch> 
