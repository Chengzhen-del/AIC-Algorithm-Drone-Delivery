<?xml version="1.0"?>
<launch>
  <node pkg="tutorial_basic_feng" type="mocap_forward.py" name="mocap_forward" output="screen">
    <param name="topic_prefix" value="/ground_truth" />
    <rosparam param="vehicle_names">['iris_0', 'iris_1', 'iris_2']</rosparam>
  </node>
  <node pkg="tutorial_basic_feng" type="fly_path.py" name="multi_drone_control" output="screen">
    <!-- 参与飞行的无人机配置 -->
    <!-- 选项1: 使用列表格式 -->
    <rosparam param="active_drones">['iris_0', 'iris_1', 'iris_2']</rosparam>
    <!-- 选项2: 使用字符串格式（注释掉上面一行，启用下面一行） -->
    <!-- <param name="active_drones" value="iris_0,iris_1,iris_2" /> -->
    
    <!-- 路径文件目录 -->
    <param name="path_file_dir" value="$(find tutorial_basic_feng)/config" />
    
    <!-- 路径跟随参数 -->
    <param name="path_cycle_time" value="35.0" />
    <param name="max_path_cycles" value="3" />
    <param name="path_start_hover_time" value="3.0" />
    
    <!-- 圆形飞行参数 -->
    <param name="circle_flight_laps" value="2" />
    
    <!-- 相位差参数 -->
    <param name="start_phase" value="0.25" />
    <param name="phase_interval" value="0.1667" />
    <!-- 自定义相位（可选，如果设置了会覆盖自动计算的相位） -->
    <!-- <rosparam param="custom_phases">[0.25, 0.0833, -0.0833]</rosparam> -->
    
    <!-- 飞行参数 -->
    <param name="circle_radius" value="1.5" />
    <param name="flight_height" value="1.3" />
    <param name="circle_speed" value="0.2" />
  </node>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find tutorial_basic_feng)/rviz/default.rviz"/>
</launch>
